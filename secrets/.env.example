# Environment variables for Flutter app
# Copy this to secrets/.env and fill in with real values

# API Configuration
TMDB_API_KEY=your_tmdb_api_key_here

# Per-flavor backend URLs (selected at runtime via the FLAVOR define)
DEV_BACKEND_URL=http://localhost:8080
STG_BACKEND_URL=https://api-staging.example.com
PROD_BACKEND_URL=https://api.example.com

# Add other environment variables as needed
